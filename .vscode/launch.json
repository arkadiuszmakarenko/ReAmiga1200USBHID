{
  // Single launch profile: builds Debug, starts OpenOCD (same as Makefile), and connects GDB
  "version": "0.2.0",
  "configurations": [

    {
      "name": "RISC-V Debug (OpenOCD + GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/firmware/Bootloader/build-debug/Bootloader.elf",
      "args": [],
      "stopAtEntry": true,
      "cwd": "${workspaceFolder}/firmware/Bootloader",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/MRS_Toolchain_Linux_x64_V210/RISC-V Embedded GCC12/bin/riscv-wch-elf-gdb",
      "setupCommands": [
        {
          "description": "Load executable file",
          "text": "file ${workspaceFolder}/firmware/Bootloader/build-debug/Bootloader.elf",
          "ignoreFailures": false
        },
        {
          "description": "Connect to OpenOCD",
          "text": "target extended-remote localhost:3333",
          "ignoreFailures": false
        },
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Reset and halt the target",
          "text": "monitor reset halt",
          "ignoreFailures": false
        },
        {
          "description": "Load program to flash",
          "text": "load",
          "ignoreFailures": false
        },
        {
          "description": "Reset again to start from beginning",
          "text": "monitor reset halt",
          "ignoreFailures": false
        },
        {
          "description": "Set breakpoint at main",
          "text": "tbreak main",
          "ignoreFailures": true
        }
      ],
      "launchCompleteCommand": "exec-continue",
      "preLaunchTask": "Debug: Build then OpenOCD",
      // Optional: if you prefer to close OpenOCD after debugging, create a task to kill it and reference it here
      // "postDebugTask": "OpenOCD: Stop"
      "logging": {
        "trace": false,
        "traceResponse": false,
        "engineLogging": false
      }
    }
  ]
}
